<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- DJ controllers with built-in audio interfaces (DDJ-FLX10) present an input side to CoreAudio;
         opening the device under the hardened runtime needs this even though DEEJ-AY only plays out. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
